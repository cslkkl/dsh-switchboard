{
  "name": "dsh-switchboard",
  "version": "0.1.0",
  "type": "module",
  "description": "DeepSeek Harness 插件：给子智能体和智能体团队队友逐个指定模型，点一下就换。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cslkkl/dsh-switchboard.git"
  },
  "homepage": "https://github.com/cslkkl/dsh-switchboard#readme",
  "bugs": {
    "url": "https://github.com/cslkkl/dsh-switchboard/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "subagent",
    "agent-teams",
    "model-routing",
    "llm"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  }
}
